# API server
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=https://localhost:8080
API_TLS_CERT=./.private/certs/localhost.pem
API_TLS_KEY=./.private/certs/localhost-key.pem

# UI server
UI_HOST=0.0.0.0
UI_PORT=3000

# Workers
WORKER_CONCURRENCY=1

# Reaper (run with: make run-worker NAME=reaper)
# Sweeps stuck workflow runs. Set any TTL to 0 (or leave empty) to disable
# that status's sweep.
WORKER_REAPER_TICK_INTERVAL=60s
WORKER_REAPER_RUNNING_TTL=1h
WORKER_REAPER_PAUSED_TTL=4h
WORKER_REAPER_PENDING_APPROVAL_TTL=24h

# Redis (run with: docker compose up redis -d)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB (run with: docker compose up mongodb -d)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=immaiwin

# Schwab
SCHWAB_CLIENT_ID=your_client_id
SCHWAB_CLIENT_SECRET=your_client_secret
SCHWAB_CALLBACK_URL=https://localhost:8080/auth/schwab/callback

# Encryption (optional — 64 hex chars / 32 bytes for AES-256-GCM connection config encryption at rest)
ENCRYPTION_KEY=9f0a1f49e6f12addb9b53595407c0dd78cad5be930bc13ffe27521b78fe2aa1d

# Auth (JWT + cookies)
# JWT_SECRET MUST be set in any non-dev deployment — empty default refuses boot.
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=dev_only_change_me_0123456789abcdef0123456789abcdef
AUTH_JWT_TTL=168h
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=true
# Absolute origin where SPA lives — OAuth callback redirects land here.
AUTH_UI_BASE_URL=http://localhost:3000

# Auth — OAuth Google (leave CLIENT_ID empty to disable provider)
# IMPORTANT: REDIRECT_URL host must match the host the UI uses to reach
# the API (VITE_API_URL, defaults to http://localhost:8080). Browsers
# scope cookies per host, and localhost != localhost — a mismatch means
# the cookie set on callback won't travel on /auth/me from the UI, so
# the user lands on /login despite the OAuth flow succeeding server-side.
# Register the SAME URL in the Google console.
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URL=https://localhost:8080/auth/oauth/google/callback

# Auth — OAuth GitHub (leave CLIENT_ID empty to disable provider)
# Same host-match rule as Google above.
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_REDIRECT_URL=https://localhost:8080/auth/oauth/github/callback

# Sandbox (Docker- or k3s-based isolated code execution for sandbox_script workflow nodes)
SANDBOX_ENABLED=false
SANDBOX_BACKEND=docker
SANDBOX_RUNTIME=
SANDBOX_POOL_SIZE=2
SANDBOX_DOCKER_HOST=
SANDBOX_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
SANDBOX_K3S_NAMESPACE=immaiwin-sandbox
SANDBOX_K3S_RUNTIMECLASS=gvisor
SANDBOX_IMAGE_REGISTRY=
SANDBOX_POD_CIDR=10.42.0.0/16
SANDBOX_SERVICE_CIDR=10.43.0.0/16
SANDBOX_LINKLOCAL_CIDR=169.254.0.0/16

# Polymarket watcher (run with: make run-worker NAME=polymarket-watcher)
# Number of past trades tracked per asset for the rolling average (default: 20).
POLYMARKET_WINDOW_SIZE=20
# Flag a trade when its size exceeds this multiple of the rolling average (default: 3.0).
POLYMARKET_SIZE_MULTIPLIER=3.0
# Always flag a trade when its size (in USDC) meets or exceeds this value (default: 10000).
POLYMARKET_MIN_ABSOLUTE_SIZE=10000

# skills
SKILLS_ENABLED=true
SKILLS_DIR=$PWD/skills/bundled