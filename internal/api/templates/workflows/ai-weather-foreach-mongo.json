{
  "name": "AI Weather Agent — Mongo + for_each fan-out",
  "description": "Reads a list of cities from a Mongo collection, then loops over every document with a for_each. Each iteration runs the SAME AI agent as the base AI Weather templates (get_weather via HTTP as_tool → weather-formatter skill → publish_weather via Redis as_tool) for that city. Demonstrates: mongo_request find, the for_each `items` selector (`{{input.docs}}` un-nests the find envelope so the loop body runs once per document), an AI agent as the for_each body, and `on_error: continue` on the agent's get_weather tool so one flaky city doesn't abort the agent.\n\nNo connection records needed for Mongo — mongo_request uses the default burrow DB. The agent still needs an LLM connection: replace REPLACE_WITH_LLM_CONNECTION_ID. Seed the collection first:\n\n  go run ./.private/scripts/seed-cities/main.go Boise Reno Bend\n\nThen run the workflow (manual trigger) and watch the channel:\n\n  go run ./.private/scripts/listen-redis/main.go weather.alerts\n\nSmoke variant (SMOKE-TEST-ON-ERROR.md §7): point get_weather `url` at an unreachable host (e.g. https://127.0.0.1:1/). Because the tool target carries `on_error: continue`, the error is fed back to the LLM instead of aborting the agent; the loop still completes every city and the run lands `success`.",
  "category": "AI",
  "workflow": {
    "name": "AI Weather Agent — Mongo + for_each fan-out",
    "params": {
      "cities_collection": "weather_cities",
      "redis_channel": "weather.alerts",
      "weather_format": "%l:+%C,+%t,+humidity+%h,+wind+%w",
      "weather_style": "friendly"
    },
    "nodes": [
      {
        "id": "trigger-1",
        "type": "trigger",
        "position": { "x": -360, "y": 0 },
        "data": {
          "name": "manual_start",
          "trigger_type": "manual",
          "handles": [
            { "id": "start-out", "side": "right", "offset": 50, "paletteType": "start" }
          ]
        }
      },
      {
        "id": "mongo-1",
        "type": "mongo_request",
        "position": { "x": -80, "y": 0 },
        "data": {
          "name": "load_cities",
          "operation": "find",
          "collection": "{{params.cities_collection}}",
          "filter": {},
          "sort": { "city": 1 },
          "batch_size": 100,
          "handles": [
            { "id": "success", "side": "right", "offset": 35, "paletteType": "success" },
            { "id": "in-left", "side": "left", "offset": 50, "paletteType": "receive" }
          ]
        }
      },
      {
        "id": "foreach-1",
        "type": "for_each",
        "position": { "x": 240, "y": 0 },
        "data": {
          "name": "loop_cities",
          "items": "{{input.docs}}",
          "handles": [
            { "id": "item", "side": "right", "offset": 30, "paletteType": "item" },
            { "id": "success", "side": "right", "offset": 60, "paletteType": "success" },
            { "id": "error", "side": "right", "offset": 85, "paletteType": "error" },
            { "id": "in-left", "side": "left", "offset": 50, "paletteType": "receive" }
          ]
        }
      },
      {
        "id": "agent-1",
        "type": "ai_agent",
        "position": { "x": 560, "y": 0 },
        "data": {
          "name": "weather_agent",
          "llm_connection_id": "REPLACE_WITH_LLM_CONNECTION_ID",
          "max_iterations": 6,
          "max_tokens": 1024,
          "max_tool_calls_per_iter": 2,
          "temperature": 0.2,
          "timeout_seconds": 120,
          "system_prompt": "You are a weather-reporting agent. Procedure:\n1. Call get_weather(city) to fetch current text weather.\n2. Call weather_formatter__format_weather({city, raw}) where raw is the get_weather output.\n3. Call publish_weather({city, summary, temp_f, formatted_by:'weather-formatter'}) where summary is the message field from step 2.\n4. Reply with a short confirmation.",
          "user_input": "Fetch, format, and publish the current weather for {{input.city}}.",
          "skills": [{ "slug_id": "weather-formatter", "range": "^0.1.0" }],
          "skill_config": { "weather-formatter": { "default_style": "{{params.weather_style}}", "temp_unit": "F" } },
          "handles": [
            { "id": "tool", "side": "right", "offset": 25, "paletteType": "tool" },
            { "id": "in-left", "side": "left", "offset": 50, "paletteType": "receive" }
          ]
        }
      },
      {
        "id": "http-1",
        "type": "http_request",
        "position": { "x": 920, "y": -110 },
        "data": {
          "name": "get_weather",
          "method": "GET",
          "url": "https://wttr.in/{{input.city}}?format={{params.weather_format}}&u",
          "headers": { "Accept": "text/plain" },
          "follow_redirects": true,
          "max_redirects": 10,
          "max_response_bytes": 1048576,
          "timeout_seconds": 20,
          "user_agent": "burrow-agent/1.0",
          "parse_json": false,
          "on_error": "continue",
          "as_tool": {
            "enabled": true,
            "name": "get_weather",
            "description": "Fetch current weather for a city.",
            "input_schema": {
              "type": "object",
              "properties": { "city": { "type": "string" } },
              "required": ["city"]
            }
          },
          "handles": [
            { "id": "success", "side": "right", "offset": 35, "paletteType": "success" },
            { "id": "in-left", "side": "left", "offset": 50, "paletteType": "receive" }
          ]
        }
      },
      {
        "id": "redis-1",
        "type": "redis_request",
        "position": { "x": 920, "y": 200 },
        "data": {
          "name": "publish_weather",
          "operation": "publish",
          "channel": "{{params.redis_channel}}",
          "as_tool": {
            "enabled": true,
            "name": "publish_weather",
            "description": "Publish a weather summary to the Redis channel.",
            "input_schema": {
              "type": "object",
              "properties": {
                "city": { "type": "string" },
                "summary": { "type": "string" },
                "temp_f": { "type": "number" },
                "formatted_by": { "type": "string" }
              },
              "required": ["city", "summary", "formatted_by"]
            }
          },
          "handles": [
            { "id": "success", "side": "right", "offset": 35, "paletteType": "success" },
            { "id": "in-left", "side": "left", "offset": 50, "paletteType": "receive" }
          ]
        }
      }
    ],
    "edges": [
      { "id": "e1", "source": "trigger-1", "target": "mongo-1", "sourceHandle": "start-out", "data": { "paletteType": "start" } },
      { "id": "e2", "source": "mongo-1", "target": "foreach-1", "sourceHandle": "success", "data": { "paletteType": "success" } },
      { "id": "e3", "source": "foreach-1", "target": "agent-1", "sourceHandle": "item", "data": { "paletteType": "item" } },
      { "id": "e4", "source": "agent-1", "target": "http-1", "sourceHandle": "tool", "data": { "paletteType": "tool" } },
      { "id": "e5", "source": "agent-1", "target": "redis-1", "sourceHandle": "tool", "data": { "paletteType": "tool" } }
    ]
  }
}
